ErrorDocument 404 /404.php
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(?:index\.(?:php|com))?$ https://%{HTTP_HOST}/ [R=301,L]
RewriteRule ^index\.(?:php|com)$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+public/(item|items|search)\.php(?:[?\s]) [NC]
RewriteRule ^public/(item|items|search)\.php$ /$1.php [R=301,L,NE]
RewriteRule ^(config(?:\.local)?\.php|cache|logs|config|lib|sql)(/|$) - [F,L]
RewriteRule ^public/ - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^(.*)$ public/$1 [L]

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
SetEnvIf Request_URI "^/(?:public/)?search\.php(?:[/?]|$)" pcf_search_noindex=1
Header set X-Robots-Tag "noindex, follow" env=pcf_search_noindex
<FilesMatch "\.(?:css|js|jpe?g|png|gif|webp|svg|ico|woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
